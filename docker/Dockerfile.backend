FROM node:20-alpine

WORKDIR /app

COPY backend/package*.json ./

# Installer les dépendances de production
RUN npm install --production

# Mettre à jour les paquets Alpine pour corriger les CVE système
RUN apk update && apk upgrade --no-cache

# Mettre à jour npm vers la dernière version compatible avec Node 20 (10.9.4)
RUN npm install -g npm@10.9.4

COPY backend/ .

EXPOSE 5000

CMD ["node", "-r", "./tracing.js", "server.js"]
