FROM node:20-alpine

WORKDIR /app

COPY backend/package*.json ./

# Installer les dépendances de production
RUN npm install --production

# Mettre à jour les paquets Alpine pour corriger les CVE système
RUN apk update && apk upgrade --no-cache

# Mise à jour npm vers la dernière version stable (corrige les CVE internes)
RUN npm install -g npm@latest

COPY backend/ .

EXPOSE 5000

CMD ["node", "-r", "./tracing.js", "server.js"]
